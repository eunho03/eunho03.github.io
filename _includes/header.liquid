<style>
  #navbar .site-menu { display:flex; align-items:center; justify-content:flex-end; gap:1.4rem; width:100%; min-height:3.5rem; }
  #navbar .site-menu a { color:var(--global-text-color); text-decoration:none; padding:.5rem 0; font-size:1rem; }
  #navbar .site-menu a[aria-current="page"] { color:var(--global-theme-color); font-weight:500; }
  #navbar .site-menu a:hover { color:var(--global-theme-color); }
  #navbar .site-menu a:focus-visible, #navbar .site-menu button:focus-visible { outline:2px solid var(--global-theme-color); outline-offset:4px; }
  #navbar .site-menu #light-toggle { position:static; background:transparent; border:0; color:var(--global-text-color); width:2.75rem; height:2.75rem; cursor:pointer; }
</style>
<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% endif %}" aria-label="Main navigation">
    <div class="container">
      <div class="site-menu">
        <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>about</a>
        <a href="{{ '/projects/' | relative_url }}" {% if page.permalink == '/projects/' %}aria-current="page"{% endif %}>projects</a>
        <a href="{{ '/cv/' | relative_url }}" {% if page.permalink == '/cv/' %}aria-current="page"{% endif %}>CV</a>
        <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
          <i class="fa-half-sun-moon" id="light-toggle-system"></i>
          <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
          <i class="fa-solid fa-sun" id="light-toggle-light"></i>
        </button>
      </div>
    </div>
  </nav>
</header>
